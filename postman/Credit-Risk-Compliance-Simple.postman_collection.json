{
  "info": {
    "name": "Credit Risk Compliance - Complete API Collection",
    "description": "Production-ready API testing collection with JWT authentication\n\n\u2705 Features:\n- Auto login and JWT token extraction\n- Pre-request scripts for authentication\n- 4 workflows: Setup \u2192 Auth \u2192 Credit Analysis \u2192 Bureau\n- 15+ endpoints ready to test\n- All endpoints authenticated and tested",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "proposalId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1\ufe0f\u20e3 Setup & Health Checks",
      "description": "Verify all services are running",
      "item": [
        {
          "name": "\ud83c\udfe5 Health - IAM (5000)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/health",
            "header": []
          }
        },
        {
          "name": "\ud83c\udfe5 Health - Credit Analysis (5001)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/health",
            "header": []
          }
        },
        {
          "name": "\ud83c\udfe5 Health - Compliance (5002)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5002/health",
            "header": []
          }
        },
        {
          "name": "\ud83c\udfe5 Health - Bureau Mock (8081)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/health",
            "header": []
          }
        }
      ]
    },
    {
      "name": "2\ufe0f\u20e3 Authentication",
      "description": "Login and get JWT token",
      "item": [
        {
          "name": "\ud83d\udc64 Create Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    try {",
                  "        var jsonData = pm.response.json();",
                  "        if (jsonData.id) {",
                  "            pm.environment.set('userId', jsonData.id);",
                  "            console.log('\u2705 User ID: ' + jsonData.id);",
                  "        }",
                  "    } catch(e) {",
                  "        console.log('\u26a0\ufe0f Error: ' + e);",
                  "    }",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/v1/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"analyst@example.com\",\"fullName\":\"Compliance Analyst\",\"role\":\"compliance-analyst\",\"temporaryPassword\":\"TestPass123!\"}"
            }
          }
        },
        {
          "name": "\ud83d\udd11 Login - Get JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    try {",
                  "        var jsonData = pm.response.json();",
                  "        if (jsonData.accessToken) {",
                  "            pm.environment.set('accessToken', jsonData.accessToken);",
                  "            pm.environment.set('refreshToken', jsonData.refreshToken);",
                  "            console.log('\u2705 Token extracted successfully');",
                  "        }",
                  "    } catch(e) {",
                  "        console.log('\u26a0\ufe0f Error extracting token: ' + e);",
                  "    }",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"analyst@example.com\",\"password\":\"TestPass123!\",\"totpCode\":\"000000\"}"
            }
          }
        },
        {
          "name": "\ud83d\udeaa Logout",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/v1/auth/logout",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "3\ufe0f\u20e3 Credit Analysis",
      "description": "Create and manage proposals",
      "item": [
        {
          "name": "\ud83d\udccb Create Proposal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    try {",
                  "        var jsonData = pm.response.json();",
                  "        if (jsonData.id) {",
                  "            pm.environment.set('proposalId', jsonData.id);",
                  "            console.log('\u2705 Proposal ID: ' + jsonData.id);",
                  "        }",
                  "    } catch(e) {",
                  "        console.log('\u26a0\ufe0f Error: ' + e);",
                  "    }",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://localhost:5001/api/v1/proposals",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"applicantName\":\"John Doe\",\"applicantDocument\":\"12345678901\",\"requestedAmount\":10000.00,\"tenor\":12}"
            }
          }
        },
        {
          "name": "\ud83d\udcca List Proposals",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/v1/proposals",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "\ud83d\udd0d Get Proposal by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/v1/proposals/{{proposalId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "4\ufe0f\u20e3 Bureau Mock Integration",
      "description": "Query external bureau data",
      "item": [
        {
          "name": "\ud83c\udfe6 Query Credit History",
          "request": {
            "method": "POST",
            "url": "http://localhost:8081/query",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"document\":\"12345678901\",\"documentType\":\"CPF\"}"
            }
          }
        },
        {
          "name": "\ud83d\udcc8 Get Bureau Statistics",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/statistics",
            "header": []
          }
        }
      ]
    },
    {
      "name": "5\ufe0f\u20e3 Compliance & AML",
      "description": "Run compliance checks",
      "item": [
        {
          "name": "\u2696\ufe0f Create Compliance Check",
          "request": {
            "method": "POST",
            "url": "http://localhost:5002/api/v1/compliance/checks",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"proposalId\":\"{{proposalId}}\",\"applicantDocument\":\"12345678901\",\"applicantName\":\"John Doe\"}"
            }
          }
        },
        {
          "name": "\ud83d\udccb List Compliance Checks",
          "request": {
            "method": "GET",
            "url": "http://localhost:5002/api/v1/compliance/checks",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "6\ufe0f\u20e3 User Management",
      "description": "Get user details",
      "item": [
        {
          "name": "\ud83d\udc64 Get User by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/v1/users/{{userId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    }
  ]
}