    {
      "name": "2\ufe0f\u20e3  Authentication (IAM)",
      "description": "User authentication and authorization workflows",
      "item": [
        {
          "name": "\ud83d\udcdd Create Test User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('timestamp', new Date().getTime());",
                  "pm.variables.set('testEmail', 'operator_' + pm.variables.get('timestamp') + '@test.com');",
                  "pm.variables.set('testPassword', 'SecurePass123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('\u2705 Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('\u2705 Response has user ID', () => {",
                  "    let json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.variables.set('userId', json.id);",
                  "});",
                  "pm.test('\u2705 Response has email', () => pm.response.json().should.have.property('email'));",
                  "pm.test('\u2705 Response has fullName', () => pm.response.json().should.have.property('fullName'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/users",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"testuser@example.com\",\"fullName\":\"Test Operator\",\"role\":\"desk-operator\",\"temporaryPassword\":\"TestPassword123!\"}"
            }
          },
          "response": []
        },
        {
          "name": "\ud83d\udd10 Login as Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('\u2705 Status code is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('\u2705 Response has accessToken', () => {",
                  "    let json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.variables.set('bearerToken', json.accessToken);",
                  "});",
                  "pm.test('\u2705 Response has userId', () => pm.response.json().should.have.property('userId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"testuser@example.com\",\"password\":\"TestPassword123!\",\"totpCode\":\"000000\"}"
            }
          },
          "response": []
        },
        {
          "name": "\ud83d\udc64 Get User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/users/0f3b8856-a614-4d11-9eee-ee951eb77c61",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "\ud83d\udeaa Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/logout",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          },
          "response": []
        }
