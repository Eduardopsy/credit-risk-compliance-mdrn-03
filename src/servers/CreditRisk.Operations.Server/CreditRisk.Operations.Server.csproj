<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CreditRisk.Operations.Server</AssemblyName>
    <RootNamespace>CreditRisk.Operations.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    
    <!-- MassTransit -->
    <PackageReference Include="MassTransit" Version="8.3.6" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.6" />
    
    <!-- EntityFramework -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    
    <!-- Observability -->
    <PackageReference Include="OpenTelemetry" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0" />
    
    <!-- Internal -->
    <ProjectReference Include="../../shared/CreditRisk.Shared.Contracts/CreditRisk.Shared.Contracts.csproj" />
    <ProjectReference Include="../../shared/CreditRisk.Shared.Kernel/CreditRisk.Shared.Kernel.csproj" />
    <ProjectReference Include="../../shared/CreditRisk.Shared.Observability/CreditRisk.Shared.Observability.csproj" />
    <ProjectReference Include="../../modules/compliance/CreditRisk.Compliance.Domain/CreditRisk.Compliance.Domain.csproj" />
    <ProjectReference Include="../../modules/compliance/CreditRisk.Compliance.Infrastructure/CreditRisk.Compliance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
